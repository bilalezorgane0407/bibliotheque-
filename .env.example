# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing HttpOnly session cookies (set in production).
SESSION_SECRET=""

# DB_PATH: Optional path to the SQLite database file (defaults to ./data/biblioest.db).
DB_PATH="./data/biblioest.db"

# USMBA_SSO_* : Configuration officielle pour le fournisseur SSO CAS / OIDC de l'USMBA.
# Tant que USMBA_SSO_ENABLED n'est pas "true" avec des identifiants valides,
# l'adaptateur utilise l'authentification locale vérifiée en base de données.
USMBA_SSO_ENABLED="false"
USMBA_SSO_ISSUER_URL=""
USMBA_SSO_CLIENT_ID=""
USMBA_SSO_CLIENT_SECRET=""
USMBA_SSO_REDIRECT_URI=""
