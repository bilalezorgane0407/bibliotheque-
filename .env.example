# APP_URL / SHARED_APP_URL : injectées automatiquement par AI Studio (ou URL publique en production).
APP_URL="MY_APP_URL"
SHARED_APP_URL=""

# SESSION_SECRET : clé secrète HMAC pour signer les cookies de session et les états OAuth (optionnel en développement, recommandé en production).
SESSION_SECRET=""

# DB_PATH : chemin optionnel vers la base SQLite (par défaut ./data/biblioest.db).
DB_PATH="./data/biblioest.db"

# Google Workspace Éducation / OAuth 2.0 / OIDC (seul mécanisme d'authentification institutionnelle)
# URI de redirection à déclarer dans Google Cloud Console :
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_ALLOWED_HOSTED_DOMAIN=""
GOOGLE_REQUIRE_PREPROVISIONED="false"

# Liste d'adresses e-mail habilitées comme bibliothécaires (séparées par des virgules)
LIBRARIAN_EMAILS=""

# Source d'appartenance et d'éligibilité EST Fès (un domaine Google seul ne suffit pas)
EST_ELIGIBILITY_SOURCE_URL=""
EST_ELIGIBILITY_EMAILS=""

# Désactiver les comptes fictifs d'évaluation en production ("true" pour désactiver)
DISABLE_DEMO_MODE="false"

# Configuration SMTP optionnelle pour l'envoi direct d'e-mails de rappel aux membres en retard
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

